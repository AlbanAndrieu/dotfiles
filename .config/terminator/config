[global_config]
  cell_width = 1.0
  cell_height = 1.0

[keybindings]

[profiles]
  [[default]]
    use_system_font = False
    font = JetBrainsMono Nerd Font 11

    use_theme_colors = False
    background_type = solid
    background_color = "#000000"
    foreground_color = "#d8dee9"

    cursor_blink = False
    scrollback_lines = 10000

[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default

[plugins]
