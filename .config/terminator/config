[global_config]
[keybindings]
[profiles]
  [[default]]
    cursor_blink = False
    font = JetBrainsMono Nerd Font 11
    foreground_color = "#d8dee9"
    scrollback_lines = 10000
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
