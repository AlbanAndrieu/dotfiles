#!/usr/bin/env bash
# Source from the end of ~/.bashrc before Direnv's final prompt hook.
# Preserve valid Bash history, mise, Starship and custom PROMPT_COMMAND items.
# Only repair the known malformed token created by a legacy prompt merger.
_nabla_repair_prompt_commands() {
  local declaration current repaired changed=0
  local -a entries=() result=()

  declaration="$(declare -p PROMPT_COMMAND 2>/dev/null || true)"
  if [[ "$declaration" == "declare -a"* ]]; then
    entries=("${PROMPT_COMMAND[@]}")
  elif [[ -n "${PROMPT_COMMAND+x}" ]]; then
    entries=("$PROMPT_COMMAND")
  else
    return 0
  fi

  for current in "${entries[@]}"; do
    repaired="$current"
    case "$repaired" in
      '_mise_hookhistory'|'_mise_hookhistory -a')
        repaired='history -a'
        ;;
      '_mise_hookhistory;'*)
        repaired="history -a;${repaired#_mise_hookhistory;}"
        ;;
      '_mise_hookhistory -a;'*)
        repaired="history -a;${repaired#_mise_hookhistory -a;}"
        ;;
    esac

    # Match complete commands delimited by semicolons, never arbitrary
    # substrings such as quoted messages or names with the same prefix.
    repaired="${repaired//;_mise_hookhistory -a;/;history -a;}"
    repaired="${repaired//;_mise_hookhistory;/;history -a;}"
    if [[ "$repaired" == *';_mise_hookhistory -a' ]]; then
      repaired="${repaired%;_mise_hookhistory -a};history -a"
    elif [[ "$repaired" == *';_mise_hookhistory' ]]; then
      repaired="${repaired%;_mise_hookhistory};history -a"
    fi
    [[ "$current" == "$repaired" ]] || changed=1
    result+=("$repaired")
  done

  if (( changed )); then
    if [[ "$declaration" == "declare -a"* ]]; then
      PROMPT_COMMAND=("${result[@]}")
    else
      PROMPT_COMMAND="${result[0]}"
    fi
  fi
}

_nabla_repair_prompt_commands
unset -f _nabla_repair_prompt_commands
