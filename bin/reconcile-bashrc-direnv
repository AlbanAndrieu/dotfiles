#!/usr/bin/env bash
# Reconcile local dirty $HOME/.bashrc against the already-fetched PR branch.
# Preview is read-only for the live checkout. Apply is explicit.
# Local edits ALWAYS win overlapping merge hunks; the reviewed Direnv tail is
# explicitly reinstated. Other upstream changes are three-way merged.
set -euo pipefail
umask 077

ROOT="${HOME:?}"
BRANCH="fix/terminator-starship-startup-20261024"
REF="refs/remotes/origin/$BRANCH"
STATE_ROOT="$ROOT/.local/state/dotfiles/bashrc-reconcile"
MODE="${1:---preview}"
SESSION="${2:-}"

die() { printf 'REFUSED: %s\n' "$*" >&2; exit 2; }
note() { printf '%s\n' "$*"; }
test "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$ROOT" ||
  die "HOME must be the root of the dotfiles Git checkout"
CURRENT="$(git -C "$ROOT" branch --show-current)"
test "$CURRENT" = "$BRANCH" || die "Wrong branch: $CURRENT"
REMOTE="$(git -C "$ROOT" rev-parse --verify "$REF" 2>/dev/null)" ||
  die "Fetch origin/$BRANCH first"
HEAD="$(git -C "$ROOT" rev-parse HEAD)"
git -C "$ROOT" merge-base --is-ancestor "$HEAD" "$REMOTE" ||
  die "Current HEAD cannot fast-forward to origin/$BRANCH"
test -f "$ROOT/.bashrc" && test ! -L "$ROOT/.bashrc" ||
  die "Expected regular, non-symlinked .bashrc"
test -z "$(git -C "$ROOT" diff --cached --name-only -- .bashrc)" ||
  die ".bashrc has staged changes: preserve the index and reconcile manually"

mkdir -p "$STATE_ROOT"
chmod 700 "$STATE_ROOT"
case "$MODE" in
  --preview)
    test -z "$SESSION" || die "--preview takes no session argument"
    SESSION="$(mktemp -d "$STATE_ROOT/session.XXXXXXXX")"
    cp -p "$ROOT/.bashrc" "$SESSION/local"
    git -C "$ROOT" show HEAD:.bashrc > "$SESSION/base"
    git -C "$ROOT" show "$REF":.bashrc > "$SESSION/incoming"
    printf '%s\n' "$HEAD" > "$SESSION/head"
    printf '%s\n' "$REMOTE" > "$SESSION/remote"
    sha256sum "$SESSION/local" | cut -d' ' -f1 > "$SESSION/sha256"

    # Preview regular three-way conflicts; never put markers in ~/.bashrc.
    git merge-file -p "$SESSION/local" "$SESSION/base" "$SESSION/incoming" \
      > "$SESSION/conflicts" || true
    if grep -q '^<<<<<<< ' "$SESSION/conflicts"; then
      note "Merge conflicts detected; local edits take priority in those hunks."
      note "Review $SESSION/conflicts privately (may contain shell secrets)."
    fi
    git merge-file -p --ours "$SESSION/local" "$SESSION/base" "$SESSION/incoming" \
      > "$SESSION/candidate" || die "Unable to create candidate"

    # Always place the upstream, reviewed hook at the END, after other prompt
    # integrations. Local overlapping edits are otherwise preserved.
    python3 - "$SESSION" <<'PY'
from pathlib import Path
import sys
session = Path(sys.argv[1])
candidate = session / "candidate"
incoming = (session / "incoming").read_text()
text = candidate.read_text()
marker = "# Direnv must be the last prompt integration (after Nabla, mise and Starship)."
if incoming.count(marker) != 1:
    raise SystemExit("REFUSED: cannot find unique upstream Direnv tail")
hook = incoming[incoming.index(marker):].strip() + "\n"
if text.count(marker) > 1:
    raise SystemExit("REFUSED: multiple local Direnv tail blocks")
if marker in text:
    # A customized hook could contain important local edits; keep it intact.
    if not text.endswith(hook):
        raise SystemExit("REFUSED: customized Direnv tail; inspect locally")
    text = text[:-len(hook)]
candidate.write_text(text.rstrip() + "\n\n" + hook)
PY
    bash -n "$SESSION/candidate" ||
      die "Merged Bash has syntax errors; originals preserved in $SESSION"
    grep -q 'declare -p PROMPT_COMMAND' "$SESSION/candidate" ||
      die "Expected Direnv prompt guard missing"
    note "PREVIEW ONLY: no local files or Git state changed."
    note "Backup and candidate: $SESSION (private mode 700)"
    note "Review: diff -u '$SESSION/local' '$SESSION/candidate'"
    note "Apply:  bash SCRIPT_PATH --apply '$SESSION'"
    ;;
  --apply)
    test -n "$SESSION" || die "Pass the preview session directory"
    case "$(realpath -m "$SESSION")" in
      "$STATE_ROOT"/session.*) ;;
      *) die "Session is not beneath private dotfiles state directory" ;;
    esac
    for name in local candidate head remote sha256; do
      test -f "$SESSION/$name" || die "Missing preview artifact: $name"
    done
    test "$HEAD" = "$(cat "$SESSION/head")" ||
      die "HEAD changed since preview"
    test "$REMOTE" = "$(cat "$SESSION/remote")" ||
      die "Remote ref changed since preview"
    test "$(sha256sum "$ROOT/.bashrc" | cut -d' ' -f1)" = "$(cat "$SESSION/sha256")" ||
      die ".bashrc changed since preview; create a new preview"
    bash -n "$SESSION/candidate" || die "Candidate has Bash errors"
    grep -q 'declare -p PROMPT_COMMAND' "$SESSION/candidate" ||
      die "Candidate is missing the Direnv prompt guard"

    # Refuse other locally modified tracked files touched by the remote.
    conflicting="$(comm -12 \
      <(git -C "$ROOT" diff --name-only "$HEAD" "$REF" | LC_ALL=C sort -u) \
      <({ git -C "$ROOT" diff --name-only; \
          git -C "$ROOT" diff --cached --name-only; } | LC_ALL=C sort -u) \
      | grep -v '^\.bashrc$' || true)"
    if [ -n "$conflicting" ]; then
      die "Remote touches other locally modified files: $conflicting"
    fi

    # The full preview remains available, and a separate backup persists.
    cp -p "$ROOT/.bashrc" "$SESSION/pre-apply-backup"
    if ! git -C "$ROOT" diff --quiet -- .bashrc; then
      git -C "$ROOT" stash push -m \
        "safety/bashrc before direnv rebase $HEAD" -- .bashrc ||
        die "Cannot save local .bashrc in Git stash"
    fi
    if ! git -C "$ROOT" merge --ff-only "$REF"; then
      die "Fast-forward blocked. Backup in $SESSION/pre-apply-backup; do not reset."
    fi
    cat "$SESSION/candidate" > "$ROOT/.bashrc"
    bash -n "$ROOT/.bashrc" || die "Post-apply Bash syntax invalid; backup retained"
    note "APPLIED: local edits reconciled with remote HEAD, no other files discarded."
    note "Backup: $SESSION/pre-apply-backup; Git stash also retained when applicable."
    note "Run bash '$ROOT/bin/check-terminal-config', then test in a NEW terminal."
    ;;
  *)
    die "Usage: bash SCRIPT_PATH --preview | --apply SESSION_DIR"
    ;;
esac
