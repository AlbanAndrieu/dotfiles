#!/usr/bin/env python3
"""Offline contract of ssht-hold: bounded window, reopened master, hard-stop timer."""

import os
from pathlib import Path
import subprocess
import tempfile
import unittest

SCRIPT = Path(__file__).with_name("ssht-hold")


class SshtHoldContract(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        stubs = Path(self.tmp.name)
        self.log = stubs / "calls.log"
        for name in ("ssh", "systemctl", "systemd-run", "logger"):
            stub = stubs / name
            stub.write_text(f'#!/bin/sh\necho "{name} $*" >> "{self.log}"\n')
            stub.chmod(0o755)
        self.env = {**os.environ, "PATH": f"{stubs}:{os.environ['PATH']}"}

    def run_hold(self, *args):
        return subprocess.run(
            ["bash", str(SCRIPT), *args],
            env=self.env,
            capture_output=True,
            text=True,
            timeout=10,
        )

    def calls(self):
        return self.log.read_text() if self.log.exists() else ""

    def test_opens_master_until_date_and_schedules_close(self):
        result = self.run_hold("now + 10 days")
        self.assertEqual(result.returncode, 0, result.stderr)
        calls = self.calls()
        self.assertIn("ssh -O exit truenas", calls)
        self.assertRegex(calls, r"ssh -fN -o ControlMaster=yes -o ControlPersist=8\d{5}s ")
        self.assertRegex(calls, r"systemd-run --user .*--unit=ssht-hold-truenas --on-calendar=\d{4}-\d\d-\d\d .* ssh -O exit truenas")

    def test_refuses_past_too_long_and_unreadable_dates(self):
        for when in ("yesterday", "now + 40 days", "not-a-date"):
            with self.subTest(when=when):
                result = self.run_hold(when)
                self.assertEqual(result.returncode, 2)
                self.assertNotIn("ssh -fN", self.calls())

    def test_cancel_stops_timer_and_master(self):
        result = self.run_hold("--cancel")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("systemctl --user stop ssht-hold-truenas.timer", self.calls())
        self.assertIn("ssh -O exit truenas", self.calls())


if __name__ == "__main__":
    unittest.main()
