#!/usr/bin/env python3
"""Offline Git regression: conflicted .bashrc keeps local data and prompt hook."""
import os
from pathlib import Path
import subprocess
import tempfile
import unittest

SCRIPT = Path(__file__).with_name("reconcile-bashrc-direnv")
BRANCH = "fix/terminator-starship-startup-20261024"
HOOK = """# Direnv must be the last prompt integration (after Nabla, mise and Starship).
if command -v direnv >/dev/null 2>&1; then
  _nabla_direnv_prompt="$(declare -p PROMPT_COMMAND 2>/dev/null || true)"
  if ! declare -F _direnv_hook >/dev/null 2>&1 || [[ "$_nabla_direnv_prompt" != *"_direnv_hook"* ]]; then
    eval "$(direnv hook bash)"
  fi
  unset _nabla_direnv_prompt
fi
"""


def git(folder, *args):
    return subprocess.run(
        ["git", "-C", str(folder), *args],
        capture_output=True, text=True, check=True, timeout=10,
    ).stdout.strip()


class ReconcileBashrcContract(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix="dotfiles-reconcile-")
        base = Path(self.tmp.name)
        self.home = base / "home"
        self.home.mkdir()
        self.remote = base / "remote.git"
        self.other = base / "other"

        git(self.home, "init", "-b", BRANCH)
        git(self.home, "config", "user.name", "Local Test")
        git(self.home, "config", "user.email", "test@example.invalid")
        git(self.home, "config", "commit.gpgsign", "false")
        git(self.home, "config", "core.hooksPath", "/dev/null")
        (self.home / ".bashrc").write_text("PS1='base'\nPROMPT_COMMAND='history -a'\n")
        (self.home / "keep.txt").write_text("keep\n")
        git(self.home, "add", ".bashrc", "keep.txt")
        git(self.home, "commit", "-m", "init")

        subprocess.run(
            ["git", "clone", "--bare", str(self.home), str(self.remote)],
            capture_output=True, check=True, timeout=10,
        )
        git(self.home, "remote", "add", "origin", str(self.remote))
        git(self.home, "fetch", "origin", BRANCH)

        subprocess.run(
            ["git", "clone", "--branch", BRANCH, str(self.remote), str(self.other)],
            capture_output=True, check=True, timeout=10,
        )
        git(self.other, "config", "user.name", "Remote Test")
        git(self.other, "config", "user.email", "test@example.invalid")
        git(self.other, "config", "commit.gpgsign", "false")
        git(self.other, "config", "core.hooksPath", "/dev/null")
        (self.other / ".bashrc").write_text(
            "PS1='remote'\nPROMPT_COMMAND='history -a'\n\n" + HOOK
        )
        git(self.other, "add", ".bashrc")
        git(self.other, "commit", "-m", "upstream hook")
        git(self.other, "push", "origin", BRANCH)
        git(self.home, "fetch", "origin", BRANCH)

        (self.home / ".bashrc").write_text(
            "PS1='my local personalized prompt'\n"
            "PROMPT_COMMAND='history -a'\n"
            "# preserve this personal line\n"
        )
        self.env = {**os.environ, "HOME": str(self.home)}

    def tearDown(self):
        self.tmp.cleanup()

    def run_tool(self, *args):
        return subprocess.run(
            ["bash", str(SCRIPT), *args], cwd=self.home,
            env=self.env, capture_output=True, text=True, timeout=10,
        )

    def preview(self):
        result = self.run_tool("--preview")
        self.assertEqual(result.returncode, 0, result.stderr)
        sessions = list((self.home / ".local/state/dotfiles/bashrc-reconcile").glob("session.*"))
        self.assertEqual(len(sessions), 1)
        return sessions[0]

    def test_preview_preserves_live_local_file(self):
        before = (self.home / ".bashrc").read_text()
        head = git(self.home, "rev-parse", "HEAD")
        session = self.preview()
        self.assertEqual((self.home / ".bashrc").read_text(), before)
        self.assertEqual(git(self.home, "rev-parse", "HEAD"), head)
        merged = (session / "candidate").read_text()
        self.assertIn("my local personalized prompt", merged)
        self.assertIn("# preserve this personal line", merged)
        self.assertEqual(merged.count("Direnv must be the last prompt integration"), 1)
        self.assertTrue(merged.rstrip().endswith("fi"))
        self.assertTrue((session / "conflicts").exists())
        self.assertNotIn("<<<<<<<", merged)

    def test_apply_preserves_local_edits_and_stash(self):
        session = self.preview()
        result = self.run_tool("--apply", str(session))
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(
            git(self.home, "rev-parse", "HEAD"),
            git(self.home, "rev-parse", "origin/" + BRANCH),
        )
        actual = (self.home / ".bashrc").read_text()
        self.assertIn("my local personalized prompt", actual)
        self.assertIn("# preserve this personal line", actual)
        self.assertIn("declare -p PROMPT_COMMAND", actual)
        self.assertTrue((session / "pre-apply-backup").exists())
        self.assertIn("safety/bashrc", git(self.home, "stash", "list"))

    def test_apply_rejects_changed_live_file(self):
        session = self.preview()
        with (self.home / ".bashrc").open("a") as f:
            f.write("# changed since preview\n")
        result = self.run_tool("--apply", str(session))
        self.assertEqual(result.returncode, 2)
        self.assertIn("changed since preview", result.stderr)
        self.assertIn("# changed since preview", (self.home / ".bashrc").read_text())


if __name__ == "__main__":
    unittest.main()
