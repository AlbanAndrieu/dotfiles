#!/usr/bin/env bash
# Geany launcher for macOS and Ubuntu
# - macOS: Homebrew cask (/Applications/Geany.app); files are opened through
#   "open" so that relative paths and an already running Geany are handled
# - Ubuntu: apt package, forced to the X11 GDK backend (Wayland issues)

if [[ "$(uname -s)" == Darwin ]]; then
  app="/Applications/Geany.app"
  if [[ ! -d "$app" ]]; then
    echo "geany: $app not found (brew install --cask geany)" >&2
    exit 127
  fi
  # Options (e.g. --line, -l) are not supported by "open": call the binary
  for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
      exec "$app/Contents/MacOS/geany" "$@"
    fi
  done
  exec open -a "$app" "$@"
fi

export GDK_BACKEND=x11
exec /usr/bin/geany "$@"
